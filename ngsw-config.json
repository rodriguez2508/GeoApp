{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "urls": [
          "https://openlayers.org/en/v6.1.1/css/ol.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-performance",
      "urls": [
        "https://geoloc-app.onrender.com/api/v1/**"
      ],
      "version": 1,
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "0s",
        "strategy": "freshness",
        "timeout": "5s"

      }
    },
    {
      "name": "app-performance",
      "urls": [
        "https://geoloc-app.onrender.com/traveler/*travel-request*",
        "https://geoloc-app.onrender.com/traveler/*travel-history*"
      ],
      "version": 1,
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "7d",
        "strategy": "freshness",
        "timeout": "1s"

      }
    }

  ]
   
}

